# Copy to .env and fill in. .env is gitignored.
#
# Only DISCOVERY needs an API key. Deterministic replay, the eval matrix, and
# `cua discover --mock` all run with no key and no network:
#     uv run cua replay --capability member.savings-balance@1.0.0 --input memberId=100042
#     uv run cua eval
#     uv run cua discover --mock

ANTHROPIC_API_KEY=

# Model used for the discovery loop only. Never used during replay.
CUA_MODEL=claude-opus-5

# Ports
CUA_TARGET_APP_PORT=4000
CUA_OPERATOR_PORT=4100

# Set to 1 to run the browser headed (required for the Tier-A human handoff demo).
CUA_HEADED=0

# Demo credentials for the FAKE local target app. Not real, not sensitive, but they are
# still resolved via secretRef and never written into artifacts, logs, or LLM prompts.
CUA_DEMO_USERNAME=operator
CUA_DEMO_PASSWORD=demo-pass-not-a-real-secret
